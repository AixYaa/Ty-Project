        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "国际化内容对象，键为语言代码，值为翻译对象"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "保存成功"
          }
        }
      }
    },
